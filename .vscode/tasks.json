{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Compile LaTeX (pdflatex)",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}/synopsis"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$latex"]
    }
  ]
}
